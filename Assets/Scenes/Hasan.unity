  nextSceneName: 
  infoHoldTime: 8
  minSkipWaitTime: 3
  exitFadeOutDuration: 1
  lineInterval: 0.8
  lineFadeDuration: 0.55
  headingText: Black-headed Squirrel Monkey
  infoLines:
  - "IUCN'nin 2021 de\u011Ferlendirmesine g\xF6re:"
  - '- Tehlike kategorisi: Endangered (EN).'
  - "- Yaln\u0131zca Brezilya Amazonlar\u0131'nda \xE7ok s\u0131n\u0131rl\u0131 bir b\xF6lgede ya\u015F\u0131yor."
  - "- Mevsimsel olarak su alt\u0131nda kalan ormanlara ba\u011F\u0131ml\u0131."
  - "- \u0130klim de\u011Fi\u015Fikli\u011Fi, y\u0131ll\u0131k ya\u011F\u0131\u015F d\xF6ng\xFCs\xFCn\xFC ciddi bi\xE7imde de\u011Fi\u015Ftirebilecek en \xF6nemli tehdit olarak belirtiliyor."
  - "- De\u011Ferlendirmede gelecek 30 y\u0131lda pop\xFClasyonun en az %50 azalabilece\u011Fi \xF6ng\xF6r\xFCl\xFCyor."
  headingFontSize: 54
  subheadingFontSize: 32
  bulletFontSize: 27
  headingColor: {r: 1, g: 0.96, b: 0.88, a: 1}
